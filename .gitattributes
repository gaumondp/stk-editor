# Normalize text files for consistent cross-platform checkouts.
* text=auto eol=lf

# Windows command files require CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary application assets must not receive text conversion or text diffs.
*.icns binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.wav binary
*.stk binary
