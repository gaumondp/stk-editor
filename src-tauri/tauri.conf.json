{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "STK Forge",
    "version": "0.2.0",
    "identifier": "com.stkforge.desktop",
    "build": {
     "frontendDist": "../dist",
     "devUrl": "http://localhost:1420",
     "beforeDevCommand": "pnpm run dev",
     "beforeBuildCommand": "pnpm run build"
     },
    "app": {
     "windows": [
      {
       "label": "main",
       "title": "STK Forge",
       "width": 1280,
       "height": 820,
       "minWidth": 960,
       "minHeight": 640,
       "resizable": true,
       "fullscreen": false
      }
      ],
     "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost"
     },
     "withGlobalTauri": false,
     "trayIcon": null
     },
"bundle": {
      "active": true,
      "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
      "targets": ["app", "dmg", "nsis"],
      "externalBin": [],
     "category": "Utility",
     "shortDescription": "Create and compile sample kits for the Sonicware SmplTrek (fw 3.2)",
     "longDescription": "STK Forge lets you create, edit, save and compile sample kits for the Sonicware SmplTrek firmware 3.2. Test only on SmplTrek fw 3.2.",
      "macOS": {
        "minimumSystemVersion": "13.0",
        "hardenedRuntime": true
        },
     "windows": {
      "nsis": {
       "languages": ["English", "French", "Japanese"]
       }
       }
     }
   }
